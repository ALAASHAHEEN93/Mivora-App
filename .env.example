# Copy to .env.local. Never commit real values.
# Local Docker database (see docker-compose.yml). Without DATABASE_URL the app uses built-in demo data.
DATABASE_URL="postgresql://mivora:mivora_local_only@localhost:5432/mivora"
# Signs sign-in codes. Generate your own: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Local mail catcher (docker compose service "mail"); read mails at http://localhost:8025
SMTP_URL="smtp://127.0.0.1:1025"
EMAIL_FROM="Mivora <hallo@example.invalid>"
# Comma-separated emails that may review provider submissions at /de/admin
ADMIN_EMAILS="admin@example.invalid"
