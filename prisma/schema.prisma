// Mivora catalogue schema (implementation step 4).
// Accounts, child profiles and bookings come in later steps.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingStatus {
  draft
  pending
  published
  archived
}

enum SessionStatus {
  scheduled
  cancelled
  full
}

model Provider {
  id         String     @id @default(cuid())
  name       String
  verified   Boolean    @default(false)
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Venue {
  id         String     @id @default(cuid())
  name       String
  street     String
  postalCode String
  city       String
  district   String
  lat        Float
  lng        Float
  activities Activity[]

  @@index([city, district])
}

model Activity {
  id                  String        @id @default(cuid())
  slug                String        @unique
  status              ListingStatus @default(draft)
  categories          String[]
  ageMin              Int
  ageMax              Int
  priceKind           String // "free" | "paid"
  priceCents          Int?
  priceUnit           String? // "perChild" | "perFamily" | "perSession"
  languages           String[]
  setting             String // "indoor" | "outdoor" | "both"
  accessibility       String[]
  accessibilitySource String // "provider" | "verified"
  bookingMode         String // "external_link" | "inquiry"
  externalUrl         String?
  cancellationPolicy  String
  originalLocale      String
  sourceType          String // "provider" | "admin" | "partner_feed" | "demo"
  sourceReference     String
  lastVerifiedAt      DateTime
  expiresAt           DateTime
  accent              String

  photoSrc       String?
  photoCredit    String?
  photoSourceUrl String?
  photoLicense   String?

  /// Who submitted it (provider account); null for demo/admin-entered listings.
  submittedBy   User?   @relation("Submissions", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedById String?
  /// Reason shown to the provider when a submission is rejected.
  reviewNote    String?
  auditLog      AuditLog[]

  provider     Provider              @relation(fields: [providerId], references: [id])
  providerId   String
  venue        Venue                 @relation(fields: [venueId], references: [id])
  venueId      String
  translations ActivityTranslation[]
  sessions     Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
}

model ActivityTranslation {
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId   String
  locale       String
  title        String
  summary      String
  description  String
  cancellation String?

  @@id([activityId, locale])
}

model Session {
  id         String        @id @default(cuid())
  activity   Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String
  startsAt   DateTime      @db.Timestamptz(3)
  endsAt     DateTime      @db.Timestamptz(3)
  status     SessionStatus @default(scheduled)

  @@index([activityId, startsAt])
  @@index([startsAt])
}

// ---------- Accounts & family (step 6) ----------
// Data minimisation: we store the parent's email and, per child, only an optional
// nickname, birth year and interests. No full names, birthdays, photos or health data.

model User {
  id        String        @id @default(cuid())
  email     String        @unique // stored lower-case
  locale    String        @default("de")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sessions  AuthSession[]
  children  Child[]
  saved     SavedActivity[]
  planned   PlannedItem[]
  submissions Activity[] @relation("Submissions")
  auditLog    AuditLog[]
}

/// One-time sign-in code sent by email. Only an HMAC of the code is stored.
model LoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// Signed-in device. Only a SHA-256 of the session token is stored.
model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Child {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  nickname  String? // optional, max 30 chars
  birthYear Int
  interests String[] // category slugs
  color     String   @default("orange")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Hearted activities, synced across the family's devices.
model SavedActivity {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  @@id([userId, activityId])
}

/// A session put into the family calendar. `key` is "activityId|startsAt|endsAt" as used by the app.
model PlannedItem {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  key        String
  activityId String
  startsAt   DateTime @db.Timestamptz(3)
  endsAt     DateTime @db.Timestamptz(3)
  childIds   String[] @default([]) // which of the family's children go (ids of Child rows of the same user)
  createdAt  DateTime @default(now())

  @@unique([userId, key])
  @@index([userId, startsAt])
}

/// Every status change of a listing: who did what, when, and why.
model AuditLog {
  id         String    @id @default(cuid())
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  activityId String?
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  action     String // "submitted" | "approved" | "rejected"
  note       String?
  createdAt  DateTime  @default(now())

  @@index([activityId, createdAt])
}
