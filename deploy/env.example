# Copy to deploy/.env on the server (never commit it). All values are examples.

# Web address. Without your own domain you can use <server-ip>.sslip.io, e.g. 203.0.113.10.sslip.io
DOMAIN=203.0.113.10.sslip.io

# Password gate for testers. Create the hash with:
#   docker run --rm caddy:2.10 caddy hash-password --plaintext 'your-tester-password'
# In this file write every "$" in the hash as "$$".
GATE_USER=tester
GATE_HASH=$$2a$$14$$replace-with-the-generated-hash

# Long random values: openssl rand -base64 32
DB_PASSWORD=replace-me
AUTH_SECRET=replace-me-with-at-least-32-characters

# Email for sign-in codes, from your email provider's SMTP settings (EU provider recommended).
SMTP_URL=smtps://USER:PASSWORD@smtp.example.eu:465
EMAIL_FROM=Mivora <hallo@your-domain.example>

# Who may review provider listings
ADMIN_EMAILS=you@example.com
